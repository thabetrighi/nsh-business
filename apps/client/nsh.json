{
  "name": "NSH Business",
  "id": "dz.nshbusiness.app",
  "version": "0.1.0",
  "build": 1,
  "icon": "packaging/icon.png",
  "rust": ".",
  "root": "App",
  "theme": "theme.json",
  "appearance": "system",
  "singleInstance": true,
  "updater": {
    "github": "thabetrighi/nsh-business"
  },
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "statusBar": true,
    "clipboard": true,
    "picker": true,
    "openUrl": {
      "schemes": [
        "https",
        "tel",
        "sms",
        "mailto"
      ]
    },
    "audio": true,
    "notifications": true
  }
}
